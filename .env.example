# ===========================================================================
# Pune-Flats: Environment Configuration
# ===========================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# ===========================================================================

# ---------------------------------------------------------------------------
# PostgreSQL + PostGIS
# ---------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=puneflats
DB_PASSWORD=puneflats_dev_password
DB_NAME=puneflats
DB_SSLMODE=disable
# Max open connections in the pool (tune for production)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=30

# ---------------------------------------------------------------------------
# Go API Server
# ---------------------------------------------------------------------------
API_PORT=8080
API_ENV=development
# Trusted origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------------------------------------------------------------------------
# Authentication — JWT
# ---------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# ---------------------------------------------------------------------------
# Authentication — OTP
# ---------------------------------------------------------------------------
# Provider: 'twilio' or 'msg91' (abstracted behind interface)
OTP_PROVIDER=twilio
OTP_PROVIDER_API_KEY=CHANGE_ME
OTP_PROVIDER_API_SECRET=CHANGE_ME
# Twilio-specific
OTP_TWILIO_ACCOUNT_SID=CHANGE_ME
OTP_TWILIO_SERVICE_SID=CHANGE_ME
# OTP validity in minutes
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Frontend (VITE_ prefix exposes to browser bundle)
# ---------------------------------------------------------------------------
# MapLibre requires no token for basic usage with free tile providers.
# For premium tiles (e.g., MapTiler), provide a key here.
VITE_MAPTILER_KEY=CHANGE_ME_IF_USING_MAPTILER
# API base URL (used by React to call Go backend)
VITE_API_BASE_URL=http://localhost:8080
# WebSocket URL
VITE_WS_URL=ws://localhost:8080/ws

# ---------------------------------------------------------------------------
# Image Storage — AWS S3
# ---------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
S3_BUCKET_PRIVATE=puneflats-private
S3_BUCKET_PUBLIC=puneflats-public

# ---------------------------------------------------------------------------
# Email Provider (SendGrid / SES)
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=CHANGE_ME
EMAIL_FROM_ADDRESS=noreply@puneflats.in
EMAIL_FROM_NAME=PuneFlats

# ---------------------------------------------------------------------------
# AI Vision (Face/Plate Detection for To-Let scrubbing)
# ---------------------------------------------------------------------------
AI_VISION_PROVIDER=google_cloud_vision
AI_VISION_API_KEY=CHANGE_ME

# ---------------------------------------------------------------------------
# Feature Flags
# ---------------------------------------------------------------------------
ENABLE_PREMIUM_ALERTS=true
ENABLE_IMAGE_SCRUBBING=true
ENABLE_HEATMAP=true
# Maximum bounding box area in km² (anti-scraping)
MAX_BBOX_AREA_KM2=25
# Rate limiting
RATE_LIMIT_MAP_QUERIES_PER_MIN=60
RATE_LIMIT_PIN_CREATE_PER_MIN=10
